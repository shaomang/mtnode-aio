# ===== 依赖 / 构建产物 =====
node_modules/
dist/
dist_check*/
out/
docs/
release/
test/
tmp/
web/
web/downloads/MTNodeAIO-Setup-1.5.6.exe
*.blockmap
*.nsis.7z

# ===== 安装包 / 商店包 / 增量更新产物（体积大，一律不入库）=====
# 判断标准：凡「能直接安装或分发出去」的二进制产物都不入库 —— 只由发版链产出。
*.msix
*.msixbundle
*.msixupload
*.appx
*.appxbundle
*.appxupload
*.msi
# NSIS 安装器（MTNodeAIO-Setup-1.7.0.exe 等；差分块 *.blockmap 见上）
*-Setup-*.exe
# 构建产物目录的变体（dist/、dist_check*/ 之外的 dist-*、dist-msix 之类）
dist*/
# web/downloads/ 是被上面的 web/ 整目录忽略掩盖的下载产物目录，这里显式列出，
# 防止以后有人为了放开 web/ 站点源码而把整目录忽略改成 !web/ 之类时，
# 把这堆几百 MB 的安装包 / 源码包带进库。
web/downloads/*.exe
web/downloads/*.zip
web/downloads/*.zip.stamp
web/downloads/*.msix
web/downloads/*.blockmap

# ===== 打包资源（不入库，避免误上传）=====
# 注意：build/ 只放打包图标等本机资源；build.json（打包白名单）是版本真源之一，
#       必须入库 —— 发布链 scripts/release-git.mjs 会审计这类漏传。
build/
installer.nsh

# ===== 运行时数据 / 日志 =====
data/
*.log
dist/pet-publish/
dsh-home/
dsh-home-*/ 

# ===== 一次性取证 / 临时脚本与输出（开发会话产物，勿上传）=====
.tmp-*
.tmp*
# MCP 端到端 / 干净环境建图的独立档位（临时数据目录 + 独立 Electron user-data-dir）
.mcp-*
*.tmp
*.bak
*.orig
*.rej
*.old
rebuild.log
# 真渲染夹具（test/fixtures/**/*.html|js 入库，供复核）跑出来的截图只是本机证据，不入库
test/fixtures/**/shot-*.png
# 开发会话 / 助手的工作区落盘目录（应用自己写的运行期数据：聊天输入截图、探针输出），不入库
# 说明：<工作区>/.mtnode-input/ 与 <数据目录>/chat-input|devnode-input/ 是应用运行期目录，
#       见 main.js 的 CHAT_IMG_DIR_NAMES；.probe-timer/ 是一次性计时取证的输出目录。
.mtnode-input/
.probe-timer/

# ===== 编辑器 / 操作系统杂项 =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
*~

# ===== 凭据 / 密钥 / 本机配置（一律不入库）=====
# .env.example / *.example 模板仍入库（照抄即可，不含真实值）
.env
.env.*
!.env.example
!*.env.example
*.api-key
.api-key
.api-token
.deployed.json
.want-deployed.json
.install-ok
registry.json
*.local.json
sftp.json

# 桌宠可选包源（入库；勿打进安装包，见 build.json !pet-pack/**）
# pet-pack/ 保留在仓库，供开发回退安装与 release:pet 打包

# ===== dsh 集成（见 dsh/DESIGN.md）=====
.dsh-probe/
dsh/gateway/node_modules/
dsh/gateway/pnpm-lock.yaml
dsh/smoke-home*/
dsh/smoke-ws*/
.deploy-tts/

# ===== 第三方本地工具目录 / 存档 =====
# .impeccable/ 是 impeccable 技能的本机工作目录（截图 + 中间产物），不入库；
# 注意：技能本体在 mtnode-agent-skills/app/impeccable/，那份要随包发版。
.impeccable/

# ===== 本机服务运行时数据（store-saas/data/ 含账号与订单，勿上传）=====
store-saas/data/

# ===== Python 缓存 / 虚拟环境 / 本机后端产物（勿上传）=====
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

.commandcode/

# ===== 模型权重（体积大，本机下载产物不入库）=====
# 注意：不整类忽略音视频（pet-pack 下有入库的示例资源）；
#       安装包 / 临时产物另行按名字忽略，见上。
*.safetensors
*.ckpt
*.pth
*.gguf
*.onnx

# ===== 证书 / 私钥（本机 SSL 落地材料，一律不入库）=====
# 阿里云 CAS 证书包（.pem/.key/.csr 等）只放本机，不进公开仓库（origin: mtnode-aio）
ssl/
*.pem
*.key
*.crt
*.csr
*.pfx
*.p12
*.jks
*.keystore
id_rsa*