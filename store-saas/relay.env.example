# MTNode 中转站（内部测试）环境变量示例 —— 抄进服务器上的 /etc/mtnode-store.env（600 权限）
#
# 中转站本体在 store-saas/relay.mjs，对外地址：
#   https://www.mt-agent.com/mtnode/store-api/relay/v1
# 客户端「提供商」填法：类型「文本 · OpenAI 兼容」或「图像 · OpenAI 兼容」，
# Base URL = 上面那个地址，Key = 账号登录 token（管理员用 `node relay-key.mjs --user <用户名>` 发放）。
#
# 口径：只有可用余额（**元**）> 0 的账号能调；按用量扣费，金额一律按元（4 位小数）；
# 上游报错 / 超时 / 被拒一律不扣。下面带 (默认) 的都是可选项，不写就用默认值。

# ── 上游凭据（必配；缺哪个对应通道就回 503 relay_not_configured，不静默假成功） ──
MTNODE_RELAY_DEEPSEEK_KEY=
MTNODE_RELAY_IMAGE_KEY=

# ── 上游地址（默认已指向官网 / 已配好的第三方图像聚合服务，一般不用改） ──
MTNODE_RELAY_DEEPSEEK_BASE=https://api.deepseek.com
MTNODE_RELAY_IMAGE_BASE=https://api.apiyi.com/v1

# ── 超时（毫秒；图像单张 90-150s、4K 更久，默认值已放宽） ──
MTNODE_RELAY_TEXT_TIMEOUT_MS=300000
MTNODE_RELAY_IMAGE_TIMEOUT_MS=600000

# ── 模型白名单（默认 = deepseek-flash / deepseek-v4-pro / deepseek-v4-flash /
#    gpt-image-2.5-vip / -sunburst-vip / -flare-vip / gpt-image-2-vip；模型名默认原样透传）
#    逗号分隔，或 JSON 数组 [{ "id": "...", "upstream": "text|image", "upstreamModel": "..." }]
# MTNODE_RELAY_MODELS=deepseek-flash,deepseek-v4-pro,gpt-image-2.5-vip

# ── 价表覆盖（JSON；单位一律「元」：文本 元/百万 tokens、图像 元/张 —— 不出现美元与汇率）
#    默认价目：DeepSeek 官方（flash 0.02/1/4、v4-pro 0.15/4.5/13.5，高峰 ×2）、
#    gpt-image-2.5-vip 家族 0.21 元/张（上游 0.03 美元/张 × 7）。官网调价时改这里即可，不必动代码。
#    历史配置里若还是 perImageUsd（美元/张），读入时按 1 美元 = 7 元一次性折成元/张。
# MTNODE_RELAY_PRICES={"deepseek-flash":{"kind":"text","cacheHit":0.02,"cacheMiss":1,"output":4,"peakMultiplier":2}}

# ── 汇率已废弃：图像价目改为直接填「元/张」，本变量不再生效（写了会被忽略并打一条警告） ──
# MTNODE_RELAY_USD_CNY=7

# ── 高峰时段补丁：中国法定节假日官方按空闲价，代码无从判断，按 YYYY-MM-DD 列出来 ──
# MTNODE_RELAY_PEAK_OFF=2026-01-01,2026-01-02

# ── 限流（次/分；0 = 关闭该项） ──
MTNODE_RELAY_ACCOUNT_PER_MIN=60
MTNODE_RELAY_IMAGE_PER_MIN=10
MTNODE_RELAY_IP_PER_MIN=120

# ── 整包覆盖（可选）：一个 JSON 文件，字段同上面的 models / prices / quota / upstreams ──
# MTNODE_RELAY_CONFIG=/opt/mtnode-store/relay.json