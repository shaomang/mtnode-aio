# Copy this file to .env in the same folder and fill your own credentials.
# Keys stay server-side and are never serialized into ComfyUI workflows.

# Vision API (OpenAI-compatible Chat Completions)
NANFENG_VISION_BASE_URL=https://your-vision-provider.example/v1
NANFENG_VISION_API_KEY=
NANFENG_VISION_MODEL=your-vision-model
NANFENG_VISION_PROTOCOL=chat_completions

# Text/reasoning API (chat_completions or responses)
NANFENG_TEXT_BASE_URL=https://your-text-provider.example/v1
NANFENG_TEXT_API_KEY=
NANFENG_TEXT_MODEL=your-text-model
NANFENG_TEXT_PROTOCOL=chat_completions
