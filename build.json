{
  "appId": "com.mtnode.pipeline-console",
  "productName": "MTNode AI工作站",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "main-exec-launch.js",
    /* 常驻托盘 + 关闭收托盘 + 任务完成系统通知（本次需求）：main.js 顶层 require 它，
       漏进白名单 = 打包后启动即 Cannot find module './main-tray-notify.js'（窗口都出不来）。 */
    "main-tray-notify.js",
    /* 快捷会话小窗（左下角入口 + 全局 F1 的独立窗口 · 全局唯一）：main.js 顶层 require
       mini-chat-window.js，它的 preload 是 preload-mini-chat.js（两只都漏进白名单 =
       打包后启动即 Cannot find module './mini-chat-window.js'）。页面与脚本走 renderer/** 通配。 */
    "mini-chat-window.js",
    "preload-mini-chat.js",
    /* 截图标注工具（Ctrl+Alt+A）：main.js 顶层 require screenshot-overlay.js，浮层页面走
       renderer/** 通配，但它那只专用 preload 在根目录、必须单列 —— 漏了就 `Cannot find module`
       （表现为浮层起来了一片黑，标注完也交不回去）。 */
    "screenshot-overlay.js",
    "preload-screenshot.js",
    "main-proc-host.js",
    "fn-runtime.js",
    "desktop-capture.js",
    /* PDF 读取内核（pdf.js）：main.js 顶层的 pdf:probe / pdf:parse / pdf:render 与
       fnPdfRead 都走它，漏进白名单 = 打包后 Cannot find module './pdf-read.js'
       （PDF 解析、逐页识图、扫描件兜底整块失效）。旧的 pdf-doc.js / pdf-math.js
       已随自写解析器一并删除（无任何 require）。 */
    "pdf-read.js",
    "pdf-write.js",
    /* 幻灯片导出（PDF / 逐页 PNG）与演讲者第二屏窗口：main.js 顶层 require 它，
       漏进白名单 = 打包后演示的「导出 PDF / PNG / 讲者视图」整块失效（Cannot find module）。 */
    "slides-export.js",
    "preload.js",
    /* 助手侧三股流（会话流 / 活动流 / 文件树）的进程隔离（任务 8/8）：
       · assist-isolation.js = 隔离渲染进程的宿主（main.js 顶层 require）；
       · preload-assist.js   = 那只进程的专用窄口桥（宿主 loadFile 时挂上去）。
       页面与脚本走 renderer/** 通配（assist-isolated.html / app-assist-isolated.js /
       app-assist-state.js / css/assist-isolated.css 都在里面）。
       漏掉这两条 = 打包后要么启动即 Cannot find module './assist-isolation.js'
       （窗口都出不来），要么 assist.isolation 一开就白屏（页面起不来 = 隔离档失效）。 */
    "assist-isolation.js",
    "preload-assist.js",
    "preload-app.js",
    "config-providers.js",
    /* 会话转写（agentSessions）从 config.json 拆出后的独立存储：main.js 会 require 它，
       漏进白名单就是打包后 Cannot find module './agent-sessions-store.js'。 */
    "agent-sessions-store.js",
    "dsh-agent-policy.js",
    /* 上下文压缩策略（开关 / 早中晚三档 → cordis.yml 的 compaction-basic 行）：同样由
       main.js require，漏进白名单就是打包后 Cannot find module './dsh-compact-policy.js'。 */
    "dsh-compact-policy.js",
    "dsh-node.js",
    "auth-store.js",
    "tools-store.js",
    /* 工作流库（一颗节点层的封装）：main.js require 它，漏进白名单就是打包后
       Cannot find module './workflow-store.js'（「工作流库」按钮与工坊工作流下载全失效）。 */
    "workflow-store.js",
    "assets-store.js",
    "shots-cache.js",
    "apps-store.js",
    /* iframe（开发页预览 / 画布应用节点）的播放通道：apps-store.js require 它，
       漏进白名单 = 打包后 Cannot find module './preview-media.js'（应用节点里试听直接崩） */
    "preview-media.js",
    /* 应用节点（画布上的 kind appnode）：main.js require 它，漏进白名单就是
       Cannot find module './apps-node-store.js' */
    "apps-node-store.js",
    "apps-capabilities.js",
    /* 应用 / 插件窗口的重能力桥（画布 / agent / 文件 / 工具 / 联网）：main.js require 它，
       漏进白名单 = 打包后 Cannot find module './app-host-bridge.js'
       （应用窗口的 appHost.canvas / agent 一族全部 not_ready）。 */
    "app-host-bridge.js",
    /* 联网抓取 / 下载（代理、超时、重定向）：app-host-bridge.js 顶层 require 它，
       漏进白名单 = 打包后 Cannot find module './net-download.js'。 */
    "net-download.js",
    /* 应用分支合并（他人分支 → 我本机开发中的那一支）：apps-store.js require 它，
       漏进白名单 = 打包后 Cannot find module './app-branch-merge.js'
       （应用中心「选择版本…」里的「合并到我的分支」直接报错）。 */
    "app-branch-merge.js",
    /* 应用版本「完全替换」（对方那一版整份接替本机开发分支，不经过 Agent）：apps-store.js
       require 它，漏进白名单 = 打包后 Cannot find module './app-branch-replace.js'
       （应用中心那条「怎么用别人这一版？」→「直接完全替换」会直接报错）。 */
    "app-branch-replace.js",
    "wechat-pc.js",
    "wechat-fastlogin.js",
    "media-gen-global-lock.js",
    /* 重后端注册中心（与插件体系并存）：main.js require 宿主 → 宿主 require 数据层。
       漏进白名单 = 打包后启动即 Cannot find module './main-backend-registry.js'（窗口都出不来）。 */
    "main-backend-registry.js",
    "backend-registry-store.js",
    /* 项目 manifest（资产登记 / asset_id 版本 / 依赖图 / 增量重建）：同一条 require 链
       main.js → main-manifest.js → manifest-store.js，漏了打包后启动即 Cannot find module。 */
    "main-manifest.js",
    "manifest-store.js",
    /* 自动质检（proc_qa）：main.js require 它 —— ffprobe 硬指标、抽帧给 VLM、
       报告落 qa/reports/。漏进白名单 = 打包后 Cannot find module './main-qa-media.js'。 */
    "main-qa-media.js",
    /* 工作目录临时文件占用与清理（顶栏「工作目录占用与清理」+ 设置里的同名入口）：
       main.js require 它，漏进白名单就是打包后 Cannot find module './workspace-temp.js'
       （面板一点就报错，统计与清理整块失效）。 */
    "workspace-temp.js",
    /* 本地模型显存释放编排器：main.js require 它，漏进白名单 = 打包后
       Cannot find module './local-model-vram.js'（画布本地模型节点与顶栏释放按钮都会失效）。 */
    "local-model-vram.js",
    /* 系统资源探针（顶栏「性能」面板：CPU / 内存 / GPU / 磁盘 / 网速 / 连接数 / 端口监听）：
       main.js require 它，漏进白名单 = 打包后 Cannot find module './perf-probe.js'
       （面板只剩显存区块，资源检测整块失效）。 */
    "perf-probe.js",
    /* 显存读数统一出口（六个插件宿主的 nvidia-smi 轮询去重 + 搬到工作线程）：宿主用
       require("../gpu-poll.js") 取它，worker 由它按需拉起；两个文件漏进白名单就是
       打包后 Cannot find module '../gpu-poll.js' —— 宿主的显存读数整块没了，
       而且会退回「每次轮询都在主线程起子进程」的老路（每 2 秒一次 50-70ms 卡顿）。 */
    "gpu-poll.js",
    "gpu-poll-worker.js",
    /* 本地后端解释器口径（pythonw 不弹控制台）：llama / breeze / music3 / yue / h3 五个插件宿主
       六个插件宿主都 require 它，漏进白名单就是打包后 Cannot find module '../backend-python.js'。 */
    "backend-python.js",
    /* 国内镜像源单一真源：6 个插件宿主（breeze / llama / h3 / music3 / yue /
       remotion）与网关都 require 它，漏进白名单就是打包后
       Cannot find module '../cn-mirrors.js' —— 安装链会退回官方源。 */
    "cn-mirrors.js",
    "clipboard-images.js",
    /* 系统剪贴板 ↔ 文件列表（Windows CF_HDROP）：main.js require 它，文件页与资源管理器
       双向复制 / 剪切 / 粘贴全靠它；漏进白名单 = 打包后 Cannot find module
       './fs-clipboard.js'，复制 / 粘贴直接报错。 */
    "fs-clipboard.js",
    "plugin-error-repair.js",
    "mtnode-agent-skills-lib.js",
    /* 内置能力库（Agent 指示 · 内置 SKILL.md 的统一管理：覆盖层 / 源码写回 / 备份）：
       main.js 顶层 require 它，漏进白名单 = 打包后 Cannot find module
       './agent-prompts-lib.js'（设置里「内置能力」整页打不开）。 */
    "agent-prompts-lib.js",
    /* 作者「覆盖到源码」写回的那一层默认正文（agent-prompts/<id>.md + index.json 清单）。
       运行期由 agent-prompts-lib 读，渲染层靠 IPC 拿；漏进白名单 = 打包后内置能力清单是空的。 */
    "agent-prompts/**",
    /* MCP 服务端（第三方客户端接进来操作 MTNode）：主进程服务端 + 生成的契约与校验表 +
       stdio 桥脚本。mcp-tools.json 是运行时真源（tools/list 的描述正文），必须随包。 */
    "mcp-server.js",
    /* 会话桥（Paseo 远程接管 MTNode 会话）：主进程走文件层读会话 + 按会话分发实时事件，
       工具族的参数表手写（不在 mcp-tools.json 那份生成契约里），渲染层那一半在
       renderer/app-session-bridge.js（走 renderer/** 通配，无需单列）。
       漏进白名单 = 打包后 Cannot find module './session-bridge.js'（会话族整体不可用）。 */
    "session-bridge.js",
    "session-tools.js",
    /* Paseo 手机接管（应用插件 kind paseo）：整目录进白名单 ——
       · bridge-info.js 是 main.js **顶层** require 的纯函数真源（CJS，asar 内解析）；
       · main-paseo.js / preload-paseo.js 是插件主进程宿主与控制台桥，main.js require 它们；
       · ui/ 是控制台窗（loadFile 走 asar 虚拟路径）、qr.js 是自研二维码编码器（ui 以 ../qr.js 引用）。
       extraResources 也带了一份 paseo/（resources/paseo）：那是给**外部 Node** 跑桥脚本
       （acp-bridge.mjs）用的 —— 外部进程读不了 asar 内路径，两条链缺一不可。
       漏掉本条的真实后果（2026-10-14 实发过一次）：打包后启动即
       main-uncaughtException: Cannot find module './paseo/bridge-info.js'，窗口都出不来。 */
    "paseo/**",
    /* Blender 本地插件（kind blender）：主进程宿主 + 控制台窗（ui/）+ 预加载桥 + 步骤表。
       漏掉本条 = 打包后 require("./blender/main-blender.js") 直接 Cannot find module，应用起不来。 */
    "blender/**",
    "mcp-prompts.js",
    "mcp-tools.json",
    "mcp-tool-schemas.js",
    "mcp-stdio.js",
    /* MCP 的 GUI 动作执行器（mtnode_gui）：主进程直接操作窗口（注入脚本 + capturePage 截图）。
       mcp-server.js 经 main.js 注入调用，漏进白名单 = 打包后 gui 族报「执行器不可用」。 */
    "mcp-gui-agent.js",
    /* 开发调试执行器（mtnode_dev）：起一只隔离的调试实例并用 CDP 驱动它（起进程 / 截图 /
       控制台 / reload / restart）。main.js 的 dsh:dev 与 mcp() 都 require 它，
       漏进白名单 = 打包后 Cannot find module './dev-agent.js'。 */
    "dev-agent.js",
    /* MCP 的媒体生成执行体（mtnode_generate）：主进程调四路后端（图像 / 语音 / 音乐 / 视频）。
       同样由 main.js 的 mcp() 注入，漏进白名单 = 打包后生成类调用报「执行器不可用」。 */
    "mcp-media-agent.js",
    "db-store.js",
    "storage-clean.js",
    "storage-scan-worker.js",
    "speech-store.js",
    /* 音频 / 视频 → 字幕（内置工具「音频转字幕」）：main.js 与 fn-runtime 的
       mtnode.subtitle 桥会 require 它，漏进白名单 = 打包后 Cannot find module
       './media-subtitle.js'（工具一点就报「字幕后端未接线」）。 */
    "media-subtitle.js",
    "longtask-store.js",
    "ai-facts-store.js",
    "activity-store.js",
    "mtnode-agent-skills/**",
    "renderer/**",
    /* 画布读侧计算内核（canvas-doc/canvas-doc-core.js）：渲染层由 renderer/index.html 以
       <script src="../canvas-doc/canvas-doc-core.js"> 加载（web 资源，不走 require），主进程 /
       MCP / 脚本侧 require("canvas-doc/canvas-doc-core.js") 是同一份文件 —— 它不在 renderer/**
       通配里，漏了这条 = 打包后 require('./canvas-doc/canvas-doc-core.js') 直接
       Cannot find module（画布读取 / 写入的版本闸整块失效）。 */
    "canvas-doc/**",
    /* 插件安装窗（独立 BrowserWindow，plugins/main-install.js 加载 install/index.html）：
       漏进白名单 = 打包后点「安装」打不开窗（loadFile ENOENT）。 */
    "install/**",
    "pet/main-pet.js",
    "pet/standalone-main.js",
    "pet/pet-provider.js",
    "pet/preload-pet.js",
    "pet/chat-ui/**",
    "music3/**",
    "yue/**",
    "h3/**",
    /* MOSS-Music 本地音乐理解（kind mossmusic）：主进程宿主 + 控制台窗 + 预加载桥。
       漏掉本条 = 打包后 require("./moss-music/main-moss-music.js") 直接
       Cannot find module，应用起不来。 */
    "moss-music/**",
    /* MOSS-TTS-Nano 内置语音（状态栏 TTS 开关）：主进程宿主随包；随包脚手架
       （推理代码 + 内置 Deepseek 音色 + requirements）走下面的 extraResources。
       漏掉本条 = 打包后 require("./moss-tts/main-moss-tts.js") 直接
       Cannot find module，应用起不来。 */
    "moss-tts/**",
    "llama/**",
    "breeze/**",
    "infinitetalk/**",
    "soulxflashhead/**",
    "flux3klein/**",
    "qwenimage/**",
    "remotion/**",
    "plugins/**",
    "forum/**",
    "dsh/main-dsh.js",
    /* 网关单文件归档格式（打包侧 dsh/after-pack.cjs 写、运行期 dsh-node.js 读，共用这一份）：
       主进程 require 它，漏进白名单 = 打包后 Cannot find module './dsh/gateway-archive.cjs'
       （启动即崩，网关目录根本解析不出来）。 */
    "dsh/gateway-archive.cjs",
    "dsh/mtnode-llm-creds.js",
    "dsh/DESIGN.md",
    "dsh/README.md",
    "guides/**",
    "skills/**",
    /* 质检模板库（随包内置：文本质检 / 图像质检 / 视频质检 / 音频质检 / 文件质检）：
       节点下拉读的是 <appPath>/qa-templates/*.json，漏进白名单 = 打包后模板下拉是空的。 */
    "qa-templates/**",
    "templates/**",
    "package.json",
    "version",
    "updater.js",
    /* 全量更新包的分段并发下载器（多连接 Range + 断点续传 + sha512 校验）：updater.js
       顶层 require 它，漏进白名单 = 打包后 Cannot find module './update-segmented.js'
       （自更新链整条失效，用户只能手动重装）。 */
    "update-segmented.js",
    "crash-report.js",
    "!pet-pack/**",
    "!smoke.js",

    /* ── 依赖减重（体检工具 scripts/app-deps-usage.mjs 度量；electron-builder 的
       files 取反规则同样作用于自动收集的 node_modules，见
       app-builder-lib/out/util/appFileCopier.js computeNodeModuleFileSets）──
       只剪「本机运行期一定加载不到」的东西：异平台原生二进制、编译中间产物、
       sourcemap、node-gyp 输入。任何可能被 require 的代码与懒加载分支都不动。

       能力组（@opentelemetry/* · @aws-sdk/* · @smithy/* · @aws-crypto/* ·
       @mistralai/mistralai · @deepseek-ai/dsh-web-app/-frontend 及其独占下游）
       实测只存在于 dsh/gateway/node_modules，摘除由 dsh/after-pack.cjs 按
       docs/app-deps-capability.json 生效，这里**不加**对应取反：根 node_modules
       里同名的那几个（commander · picomatch · picocolors · escape-string-regexp ·
       @types/debug）在 app 树入口闭包里仍可达（docs/app-deps-prune.json 的
       trees.app：live=440.95MB / dead=0），网关树判定不适用于这棵树。 */
    "!node_modules/**/prebuilds/{darwin,linux,linuxmusl,freebsd}{,-*}",
    "!node_modules/**/prebuilds/{darwin,linux,linuxmusl,freebsd}*/**",
    "!node_modules/**/prebuilds/win32-arm64{,.node}",
    "!node_modules/**/prebuilds/win32-arm64/**",
    "!node_modules/**/prebuilds/*-arm64*",
    "!node_modules/**/prebuilds/*-arm64*/**",
    /* sharp 的无原生回退包（8.9MB）：sharp/dist/sharp.cjs 只在拿不到平台原生二进制时才
       require 它，桌面 win32-x64 上必命中 @img/sharp-win32-x64（18.9MB，保留）→ 永不加载。
       按包名精确剪，不动 @img/sharp-win32-x64 / sharp 本体。 */
    "!node_modules/@img/sharp-wasm32/**",
    "!node_modules/better-sqlite3/deps/**",
    "!node_modules/better-sqlite3/src/**",
    "!node_modules/uiohook-napi/libuiohook/**",
    "!node_modules/uiohook-napi/src/**",
    "!node_modules/**/*.{map,lib,iobj,ipdb,tlog,exp,recipe,vcxproj,vcxproj.filters,sln,gyp,gypi,Makefile2,lastbuildstate}",
    "!node_modules/**/*.d.{ts,cts,mts}",
    /* pdf.js（pdf-read.js 的唯一内核）：只用 legacy ESM 构建 + 中日韩 CMap + 标准字体 +
       WASM 解码器，其余（非 legacy 构建 / 给浏览器打包的 web/ / 类型声明 / 演示图）全剪。
       web/ 与 build/ 是同一份代码的另一套产物，主进程只 import legacy/build/pdf.mjs。 */
    "!node_modules/pdfjs-dist/{build,web,types,image_decoders}/**",
    "!node_modules/pdfjs-dist/legacy/{web,types}/**"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/uiohook-napi/**",
    "**/node_modules/node-gyp-build/**",
    /* pdf.js 是 ESM（.mjs）：Node 的 ESM 加载器读不了 asar 虚拟路径，pdf-read.js
       会把路径折算到 app.asar.unpacked，所以这份必须摊到 asar 外。 */
    "**/node_modules/pdfjs-dist/**"
  ],
  "extraResources": [
    {
      /* MCP · stdio 桥脚本：外部 MCP 客户端（Claude Code / Cursor）用**系统 Node** 拉起它，
         而 asar 内路径外部 Node 读不了 —— 所以必须放在 asar 外的 resources/ 根。
         脚本只 import node 内置模块（fs/os/path + 全局 fetch），随包零依赖。
         主进程侧路径解析见 mcp-server.js 的 stdioCommand（优先 resourcesDir）。 */
      "from": "mcp-stdio.js",
      "to": "mcp-stdio.js"
    },
    {
      /* Paseo 手机接管（手机端远程接管会话）：Paseo daemon 按 ~/.paseo/config.json 把
         acp-bridge.mjs 当 ACP provider 子进程拉起 —— 同样是**外部 Node**，asar 内路径
         读不了。整目录带过去（bridge-info.js 是面板与桥共用的同一份纯函数真源；
         本轮加上的 ui/ 与 qr.js 也一起带，resources/paseo 是一份**完整**的插件目录，
         便于从 resources 侧直接排障）。
         路径解析见 paseo/bridge-info.js 的 bridgePaths（优先 resourcesDir/paseo）。 */
      "from": "paseo",
      "to": "paseo",
      "filter": ["**/*.mjs", "**/*.js", "**/*.html", "**/*.css", "!**/node_modules/**"]
    },
