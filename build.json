{
  "appId": "com.mtnode.pipeline-console",
  "productName": "MTNode AI编排器",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "main-exec-launch.js",
    "main-proc-host.js",
    "fn-runtime.js",
    "desktop-capture.js",
    "pdf-math.js",
    "pdf-doc.js",
    "pdf-write.js",
    "preload.js",
    "preload-app.js",
    "config-providers.js",
    /* 会话转写（agentSessions）从 config.json 拆出后的独立存储：main.js 会 require 它，
       漏进白名单就是打包后 Cannot find module './agent-sessions-store.js'。 */
    "agent-sessions-store.js",
    "dsh-agent-policy.js",
    "dsh-node.js",
    "auth-store.js",
    "tools-store.js",
    "assets-store.js",
    "shots-cache.js",
    "apps-store.js",
    "apps-capabilities.js",
    /* 应用分支合并（他人分支 → 我本机开发中的那一支）：apps-store.js require 它，
       漏进白名单 = 打包后 Cannot find module './app-branch-merge.js'
       （应用中心「选择版本…」里的「合并到我的分支」直接报错）。 */
    "app-branch-merge.js",
    /* 应用版本「完全替换」（对方那一版整份接替本机开发分支，不经过 Agent）：apps-store.js
       require 它，漏进白名单 = 打包后 Cannot find module './app-branch-replace.js'
       （应用中心那条「怎么用别人这一版？」→「直接完全替换」会直接报错）。 */
    "app-branch-replace.js",
    "wechat-pc.js",
    "wechat-fastlogin.js",
    "media-gen-global-lock.js",
    /* 本地模型显存释放编排器：main.js require 它，漏进白名单 = 打包后
       Cannot find module './local-model-vram.js'（画布本地模型节点与顶栏释放按钮都会失效）。 */
    "local-model-vram.js",
    /* 系统资源探针（顶栏「性能」面板：CPU / 内存 / GPU / 磁盘 / 网速 / 连接数 / 端口监听）：
       main.js require 它，漏进白名单 = 打包后 Cannot find module './perf-probe.js'
       （面板只剩显存区块，资源检测整块失效）。 */
    "perf-probe.js",
    /* 本地后端解释器口径（pythonw 不弹控制台）：llama / breeze / music3 / yue / sensenova / h3
       六个插件宿主都 require 它，漏进白名单就是打包后 Cannot find module '../backend-python.js'。 */
    "backend-python.js",
    /* 国内镜像源单一真源：7 个插件宿主（breeze / llama / h3 / music3 / yue /
       sensenova / remotion）与网关都 require 它，漏进白名单就是打包后
       Cannot find module '../cn-mirrors.js' —— 安装链会退回官方源。 */
    "cn-mirrors.js",
    "clipboard-images.js",
    "plugin-error-repair.js",
    "mtnode-agent-skills-lib.js",
    /* MCP 服务端（第三方客户端接进来操作 MTNode）：主进程服务端 + 生成的契约与校验表 +
       stdio 桥脚本。mcp-tools.json 是运行时真源（tools/list 的描述正文），必须随包。 */
    "mcp-server.js",
    /* 会话桥（Paseo 远程接管 MTNode 会话）：主进程走文件层读会话 + 按会话分发实时事件，
       工具族的参数表手写（不在 mcp-tools.json 那份生成契约里），渲染层那一半在
       renderer/app-session-bridge.js（走 renderer/** 通配，无需单列）。
       漏进白名单 = 打包后 Cannot find module './session-bridge.js'（会话族整体不可用）。 */
    "session-bridge.js",
    "session-tools.js",
    /* Paseo 手机接管（应用插件 kind paseo）：整目录进白名单 ——
       · bridge-info.js 是 main.js **顶层** require 的纯函数真源（CJS，asar 内解析）；
       · main-paseo.js / preload-paseo.js 是插件主进程宿主与控制台桥，main.js require 它们；
       · ui/ 是控制台窗（loadFile 走 asar 虚拟路径）、qr.js 是自研二维码编码器（ui 以 ../qr.js 引用）。
       extraResources 也带了一份 paseo/（resources/paseo）：那是给**外部 Node** 跑桥脚本
       （acp-bridge.mjs）用的 —— 外部进程读不了 asar 内路径，两条链缺一不可。
       漏掉本条的真实后果（2026-10-14 实发过一次）：打包后启动即
       main-uncaughtException: Cannot find module './paseo/bridge-info.js'，窗口都出不来。 */
    "paseo/**",
    "mcp-prompts.js",
    "mcp-tools.json",
    "mcp-tool-schemas.js",
    "mcp-stdio.js",
    /* MCP 的 GUI 动作执行器（mtnode_gui）：主进程直接操作窗口（注入脚本 + capturePage 截图）。
       mcp-server.js 经 main.js 注入调用，漏进白名单 = 打包后 gui 族报「执行器不可用」。 */
    "mcp-gui-agent.js",
    "db-store.js",
    "storage-clean.js",
    "storage-scan-worker.js",
    "speech-store.js",
    "longtask-store.js",
    "ai-facts-store.js",
    "activity-store.js",
    "mtnode-agent-skills/**",
    "renderer/**",
    /* 插件安装窗（独立 BrowserWindow，plugins/main-install.js 加载 install/index.html）：
       漏进白名单 = 打包后点「安装」打不开窗（loadFile ENOENT）。 */
    "install/**",
    "pet/main-pet.js",
    "pet/standalone-main.js",
    "pet/pet-provider.js",
    "pet/preload-pet.js",
    "pet/chat-ui/**",
    "music3/**",
    "yue/**",
    "h3/**",
    "llama/**",
    "breeze/**",
    "sensenova/**",
    "remotion/**",
    "plugins/**",
    "forum/**",
    "dsh/main-dsh.js",
    "dsh/mtnode-llm-creds.js",
    "dsh/DESIGN.md",
    "dsh/README.md",
    "guides/**",
    "skills/**",
    "templates/**",
    "package.json",
    "version",
    "updater.js",
    "crash-report.js",
    "!pet-pack/**",
    "!smoke.js",

    /* ── 依赖减重（体检工具 scripts/app-deps-usage.mjs 度量；electron-builder 的
       files 取反规则同样作用于自动收集的 node_modules，见
       app-builder-lib/out/util/appFileCopier.js computeNodeModuleFileSets）──
       只剪「本机运行期一定加载不到」的东西：异平台原生二进制、编译中间产物、
       sourcemap、node-gyp 输入。任何可能被 require 的代码与懒加载分支都不动。

       能力组（@opentelemetry/* · @aws-sdk/* · @smithy/* · @aws-crypto/* ·
       @mistralai/mistralai · @deepseek-ai/dsh-web-app/-frontend 及其独占下游）
       实测只存在于 dsh/gateway/node_modules，摘除由 dsh/after-pack.cjs 按
       docs/app-deps-capability.json 生效，这里**不加**对应取反：根 node_modules
       里同名的那几个（commander · picomatch · picocolors · escape-string-regexp ·
       @types/debug）在 app 树入口闭包里仍可达（docs/app-deps-prune.json 的
       trees.app：live=440.95MB / dead=0），网关树判定不适用于这棵树。 */
    "!node_modules/**/prebuilds/{darwin,linux,linuxmusl,freebsd}{,-*}",
    "!node_modules/**/prebuilds/{darwin,linux,linuxmusl,freebsd}*/**",
    "!node_modules/**/prebuilds/win32-arm64{,.node}",
    "!node_modules/**/prebuilds/win32-arm64/**",
    "!node_modules/**/prebuilds/*-arm64*",
    "!node_modules/**/prebuilds/*-arm64*/**",
    /* sharp 的无原生回退包（8.9MB）：sharp/dist/sharp.cjs 只在拿不到平台原生二进制时才
       require 它，桌面 win32-x64 上必命中 @img/sharp-win32-x64（18.9MB，保留）→ 永不加载。
       按包名精确剪，不动 @img/sharp-win32-x64 / sharp 本体。 */
    "!node_modules/@img/sharp-wasm32/**",
    "!node_modules/better-sqlite3/deps/**",
    "!node_modules/better-sqlite3/src/**",
    "!node_modules/uiohook-napi/libuiohook/**",
    "!node_modules/uiohook-napi/src/**",
    "!node_modules/**/*.{map,lib,iobj,ipdb,tlog,exp,recipe,vcxproj,vcxproj.filters,sln,gyp,gypi,Makefile2,lastbuildstate}",
    "!node_modules/**/*.d.{ts,cts,mts}"
  ],
  "asar": true,
  "asarUnpack": [
    "**/node_modules/uiohook-napi/**",
    "**/node_modules/node-gyp-build/**"
  ],
  "extraResources": [
    {
      /* MCP · stdio 桥脚本：外部 MCP 客户端（Claude Code / Cursor）用**系统 Node** 拉起它，
         而 asar 内路径外部 Node 读不了 —— 所以必须放在 asar 外的 resources/ 根。
         脚本只 import node 内置模块（fs/os/path + 全局 fetch），随包零依赖。
         主进程侧路径解析见 mcp-server.js 的 stdioCommand（优先 resourcesDir）。 */
      "from": "mcp-stdio.js",
      "to": "mcp-stdio.js"
    },
    {
      /* Paseo 手机接管（手机端远程接管会话）：Paseo daemon 按 ~/.paseo/config.json 把
         acp-bridge.mjs 当 ACP provider 子进程拉起 —— 同样是**外部 Node**，asar 内路径
         读不了。整目录带过去（bridge-info.js 是面板与桥共用的同一份纯函数真源；
         本轮加上的 ui/ 与 qr.js 也一起带，resources/paseo 是一份**完整**的插件目录，
         便于从 resources 侧直接排障）。
         路径解析见 paseo/bridge-info.js 的 bridgePaths（优先 resourcesDir/paseo）。 */
      "from": "paseo",
      "to": "paseo",
      "filter": ["**/*.mjs", "**/*.js", "**/*.html", "**/*.css", "!**/node_modules/**"]
    },
    {
      "from": "node_modules/uiohook-napi",
      "to": "uiohook-napi",
      "filter": [
        "**/*",
        "!libuiohook/**",
        "!src/**",
        "!build/Release/obj/**",
        "!build/*.sln",
        "!build/**/*.vcxproj*",
        "!build/**/*.{lib,iobj,ipdb,exp,tlog,recipe,lastbuildstate}",
        "!prebuilds/{darwin,linux,linuxmusl,freebsd}*/**",
        "!prebuilds/win32-arm64/**",
        "!**/*.{d.ts,d.cts,d.mts,map,pdb,obj,o,a,cc,gyp,gypi}",
        "!**/{README,CHANGELOG,HISTORY,CONTRIBUTING,SERCURITY,CODE_OF_CONDUCT,AUTHORS}*",
        "!**/*.md"
      ]
    },
    {
      "from": "node_modules/node-gyp-build",
      "to": "node-gyp-build",
      "filter": ["**/*", "!**/*.{d.ts,map,md}", "!tests/**"]
    },
    {
      "from": "pet-pack",
      "to": "pet-pack",
      "filter": [
        "app.js",
        "index.html",
        "style.css",
        "chat.html",
        "chat.js",
        "persona.html",
        "preload-pet.js",
        "manifest.json",
        "live2d.bundle.js",
        "models/**",
        "vendor/**"
      ]
    },
    {
      "from": "music3-pack",
      "to": "music3-pack",
      "filter": [
        "app/**",
        "scripts/**",
        "prompts/**",
        "workflows/**",
        "requirements.txt",
        "README.md",
        "start_backend.cmd",
        ".gitignore",
        /* 静默垫片（真源 pack-shims/sitecustomize.py）：后端 spawn 时挂在 PYTHONPATH 最前，
           进程级给 subprocess / os.system 补 CREATE_NO_WINDOW；漏进白名单 = 打包后装出来的
           目录里没有它，训练 / 推理里的 ffmpeg 之类又会逐个弹终端窗。 */
        "shims/**",
        /* 开发机上跑过一次 python 就会留下 __pycache__：别打进安装包（宿主拷贝侧 copyDirRecursive
           本来就跳过它，这里把打包侧也对齐）。 */
        "!**/__pycache__/**",
        /* 安装窗的开窗步骤表（与 scripts/install.ps1 的步骤 id 同源）：
           漏进白名单 = 打包后安装窗开窗时列不出步骤表。 */
        "steps.json",
        "manifest.json"
      ]
    },
    {
      "from": "yue-pack",
      "to": "yue-pack",
      "filter": [
        "app/**",
        "scripts/**",
        "requirements.txt",
        "README.md",
        "start_backend.cmd",
        ".gitignore",
        /* 静默垫片（真源 pack-shims/sitecustomize.py）：后端 spawn 时挂在 PYTHONPATH 最前，
           进程级给 subprocess / os.system 补 CREATE_NO_WINDOW；漏进白名单 = 打包后装出来的
           目录里没有它，推理 / 切片里的 ffmpeg 之类又会逐个弹终端窗。 */
        "shims/**",
        /* 开发机上跑过一次 python 就会留下 __pycache__：别打进安装包（宿主拷贝侧 copyDirRecursive
           本来就跳过它，这里把打包侧也对齐）。 */
        "!**/__pycache__/**",
        /* 安装窗的开窗步骤表（与 scripts/install.ps1 的步骤 id 同源）：
           漏进白名单 = 打包后安装窗开窗时列不出步骤表。 */
        "steps.json",
        "manifest.json"
      ]
    },
    {
      "from": "h3-pack",
      "to": "h3-pack",
      "filter": [
        "app/**",
        "post/**",
        "scripts/**",
        "requirements.txt",
        "README.md",
        "start_backend.cmd",
        ".gitignore",
        /* 静默垫片（真源 pack-shims/sitecustomize.py）：ComfyUI 与它拉起的整条子树（自定义节点
           装依赖 / pip / ffmpeg）靠它默认不弹控制台窗；漏进白名单 = 打包后装出来的目录里没有它。 */
        "shims/**",
        /* 开发机上跑过一次 python 就会留下 __pycache__：别打进安装包（宿主拷贝侧 copyDirRecursive
           本来就跳过它，这里把打包侧也对齐）。 */
        "!**/__pycache__/**",
        /* 安装窗的开窗步骤表（与 scripts/install.ps1 的步骤 id 同源）：
           漏进白名单 = 打包后安装窗开窗时列不出步骤表。 */
        "steps.json",
        "manifest.json"
      ]
    },
    {
      "from": "llama-pack",
      "to": "llama-pack",
      "filter": [
        "app/**",
        "scripts/**",
        "templates/**",
        "requirements.txt",
        "README.md",
        "start_backend.cmd",
        ".gitignore",
        /* 静默垫片（真源 pack-shims/sitecustomize.py）：后端与它拉起的整条子树靠它默认不弹
           控制台窗；漏进白名单 = 打包后装出来的目录里没有它。 */
        "shims/**",
        /* 开发机上跑过一次 python 就会留下 __pycache__：别打进安装包（宿主拷贝侧 copyDirRecursive
           本来就跳过它，这里把打包侧也对齐）。 */
        "!**/__pycache__/**",
        /* 安装窗的开窗步骤表（与 scripts/install.ps1 的步骤 id 同源）：
           漏进白名单 = 打包后安装窗开窗时列不出步骤表。 */
        "steps.json",
        "manifest.json"
      ]
    },
    {
      "from": "breeze-pack",
      "to": "breeze-pack",
      "filter": [
        "app/**",
        "scripts/**",
        "README.md",
        "start_backend.cmd",
        ".gitignore",
        /* 静默垫片（真源 pack-shims/sitecustomize.py）：后端与它拉起的整条子树靠它默认不弹
           控制台窗；漏进白名单 = 打包后装出来的目录里没有它。 */
        "shims/**",
        /* 开发机上跑过一次 python 就会留下 __pycache__：别打进安装包（宿主拷贝侧 copyDirRecursive
           本来就跳过它，这里把打包侧也对齐）。 */
        "!**/__pycache__/**",
        /* 安装窗的开窗步骤表（与 scripts/install.ps1 的步骤 id 同源）：
           漏进白名单 = 打包后安装窗开窗时列不出步骤表。 */
        "steps.json",
        "manifest.json"
      ]
    },
    {
      "from": "remotion-pack",
      "to": "remotion-pack",
      "filter": [
        "manifest.json",
        "package.json",
        "tsconfig.json",
        "src/**",
        "render.mjs",
        "install.cmd",
        /* 安装脚本必须随包：宿主（remotion/main-remotion.js）spawn 的就是
           <pack>/scripts/install.ps1，安装窗的步骤行（node / copy / npm / check）
           全靠它逐条上报。漏掉 scripts/** 的后果是真实事故：装箱后脚本不存在，
           宿主复制完脚手架就 spawn 失败，安装窗一条步骤行、一条日志都没有
           （用户看到的就是「安装失败且没有日志」）。step.ps1 是它的步骤协议库。 */
        "scripts/**",
        "steps.json",
        "README.md",
        ".gitignore"
      ]
    },
    {
      "from": "sensenova-pack",
      "to": "sensenova-pack",
      "filter": [
        "app/**",
        "scripts/**",
        "requirements.txt",
        "README.md",
        "start_backend.cmd",
        ".gitignore",
        /* 静默垫片（真源 pack-shims/sitecustomize.py）：后端与它拉起的整条子树靠它默认不弹
           控制台窗；漏进白名单 = 打包后装出来的目录里没有它。 */
        "shims/**",
        /* 开发机上跑过一次 python 就会留下 __pycache__：别打进安装包（宿主拷贝侧 copyDirRecursive
           本来就跳过它，这里把打包侧也对齐）。 */
        "!**/__pycache__/**",
        /* 安装窗的开窗步骤表（与 scripts/install.ps1 的步骤 id 同源）：
           漏进白名单 = 打包后安装窗开窗时列不出步骤表。 */
        "steps.json",
        "manifest.json"
      ]
    }
  ],
  "afterPack": "dsh/after-pack.cjs",
  /* normal：多核压缩，明显快于 maximum；体积通常接近 */
  "compression": "normal",
  "electronVersion": "39.8.10",
  "publish": [
    {
      "provider": "generic",
      "url": "http://mt-agent.com/mtnode/updates"
    }
  ],
  "win": {
    /* 仅 nsis：打包过程会生成 win-unpacked，无需再打一份 dir */
    "icon": "build/icon.ico",
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "executableName": "MTNodeAIO"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MTNode AI编排器",
    "include": "installer.nsh",
    "runAfterFinish": true,
    "artifactName": "MTNodeAIO-Setup-${version}.${ext}",
    "differentialPackage": true
  }
}
